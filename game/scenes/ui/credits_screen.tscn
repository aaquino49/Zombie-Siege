[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/credits_screen.gd" id="1_script"]

[node name="CreditsScreen" type="CanvasLayer"]
process_mode = 3
layer = 35
visible = false
script = ExtResource("1_script")

[node name="Dim" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
color = Color(0, 0, 0, 0.55)

[node name="Center" type="CenterContainer" parent="Dim"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1

[node name="Panel" type="PanelContainer" parent="Dim/Center"]
