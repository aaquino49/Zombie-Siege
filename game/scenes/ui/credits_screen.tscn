[node name="Art" type="Label" parent="Dim/Center/Panel/Margin/Content/Scroll/Sections"]
layout_mode = 2
size_flags_horizontal = 3
autowrap_mode = 2
text = "Ittai Manero - Zombie Apocalypse Tileset (itch.io).\nFree for commercial use; raw pack is not redistributed.\nPixel sprites and UI adapted by Codex.\nKenney (Kenney Vleugels) - original art, icons and UI: CC0.\nOriginal title composition and earlier asset adaptations: Codex."

[node name="AudioHeading" type="Label" parent="Dim/Center/Panel/Margin/Content/Scroll/Sections"]
layout_mode = 2
size_flags_horizontal = 3
autowrap_mode = 2
text = "AUDIO - CC0 / PUBLIC DOMAIN"

[node name="Audio" type="Label" parent="Dim/Center/Panel/Margin/Content/Scroll/Sections"]
layout_mode = 2
size_flags_horizontal = 3
autowrap_mode = 2
text = "Kenney - Impact Sounds and Interface Sounds.\nkurt - Gunshots. EmoPreben - Zombie Moans 01.\nKilua Boy - Sunset Walk (day music).\nSkyleTheFrench - Dark Place (night music).\nCodex - original synthesized cues and arrangements."

[node name="FontsHeading" type="Label" parent="Dim/Center/Panel/Margin/Content/Scroll/Sections"]
