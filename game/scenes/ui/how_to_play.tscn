[node name="Controls" type="Label" parent="Dim/Center/Panel/Margin/Content/Scroll/Sections"]
layout_mode = 2
size_flags_horizontal = 3
autowrap_mode = 2
text = "Camera: WASD / arrows or screen edge; mouse wheel to zoom.\nTime: Space pauses; 1 / 2 / 3 change speed.\nBuild: B opens the menu; F1–F9 picks a building.\nLeft-click places; right-click / Esc cancels. Shift+click repeats; drag to place a line of walls.\nSelect: click a survivor or building for jobs, HP and workers.\nRoster: R opens survivor jobs. Esc opens the pause menu."

[node name="TipsHeading" type="Label" parent="Dim/Center/Panel/Margin/Content/Scroll/Sections"]
layout_mode = 2
size_flags_horizontal = 3
autowrap_mode = 2
text = "SURVIVAL TIPS"

[node name="Tips" type="Label" parent="Dim/Center/Panel/Margin/Content/Scroll/Sections"]
layout_mode = 2
size_flags_horizontal = 3
autowrap_mode = 2
text = "Build farms before night 3 and assign farmers.\nEnclose your colony with walls and leave a gate for workers.\nMake ammo at the Workshop before your starting supply runs out.\nPut guards in watchtowers for protection and extra range.\nProvide shelter beds for everyone at night.\nSpitters (from night 8) stop out of reach and spit acid at turrets and watchtowers: keep guards and turrets covering each other.\nSend a survivor scavenging in the morning for extra supplies; they return at nightfall, but it is risky.\nSave wood and scrap for the Radio Tower as day 8 approaches.\nReload day in the pause menu restores your last dawn autosave.\nAfter rescue, choose Keep fighting to defend your colony in endless mode."

